# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (defaults to myDatabase)
MONGODB_DB=myDatabase

# Starknet Sepolia JSON-RPC endpoint (spec v0_7). Defaults to Nethermind's free RPC;
# an Alchemy/Infura URL is more reliable.
STARKNET_RPC_URL=https://free-rpc.nethermind.io/sepolia-juno/v0_7
# Private key of the account that signs contract writes. Server-side only.
PRIVATE_KEY=
