# MongoDB connection string (Atlas: Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (defaults to myDatabase)
MONGODB_DB=myDatabase

# Password the site asks for before saving or deleting a document. Every write
# signs a Starknet transaction paid by PRIVATE_KEY's account, so writes are
# disabled while this is unset.
WRITE_PASSWORD=

# Starknet Sepolia JSON-RPC endpoint speaking spec 0.9 or 0.10 (starknet.js 10). Required, no default.
# For example Alchemy: https://starknet-sepolia.g.alchemy.com/starknet/version/rpc/v0_10/<api-key>
# Check it with: npm run check:rpc
STARKNET_RPC_URL=
# Private key of the account that signs contract writes. Server-side only.
PRIVATE_KEY=
